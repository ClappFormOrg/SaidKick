meta {
  name: Reset Branding
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/api/v1/branding
  body: none
  auth: none
}

headers {
  X-Dev-User-ID: {{devUserId}}
}

docs {
  Resets the six colours to the GovNL defaults. platform_admin only.
  The logo is not touched; use Delete Branding Logo for that.
  Writes branding.reset to audit_logs with before/after colours.

  Responses:
    200 OK — same body as GET /api/v1/branding
    401 unauthorized / 403 forbidden — not platform_admin
}
