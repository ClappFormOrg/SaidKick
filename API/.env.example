# sAId-Kick Appstore API — local development env vars.
# Copy to .env (gitignored) and adjust to taste.

# ── Postgres ───────────────────────────────────────────────────────────────────
# libpq-style DSN. Postgres 16+ recommended.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/saidkick_appstore?sslmode=disable

# Optional: separate connection string for the audit-writer role. Leave
# unset in dev — the application falls back to DATABASE_URL.
# In production, this DSN's user must be an INSERT-only role on audit_logs.
# AUDIT_DATABASE_URL=postgres://audit_writer:***@db:5432/saidkick_appstore?sslmode=require

# ── Logging ────────────────────────────────────────────────────────────────────
# silent | error | warn | info  (default: warn)
GORM_LOG_LEVEL=warn

# Duration; queries slower than this are logged at warn level (default 200ms).
SLOW_QUERY_THRESHOLD=200ms

# ── HTTP server ────────────────────────────────────────────────────────────────
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s
HTTP_SHUTDOWN_TIMEOUT=15s
# Comma-separated CIDRs for X-Forwarded-For trust (none by default).
HTTP_TRUSTED_PROXIES=
# Unauthenticated GET /metrics listener (default :9090). Never route it
# through an ingress.
METRICS_ADDR=:9090

# ── App mode ───────────────────────────────────────────────────────────────────
# APP_ENV restricts which modes are allowed. Dev mode is refused when
# APP_ENV=production.
APP_ENV=development

# APP_DEV_MODE=true activates several dev-only shortcuts (all refused in prod):
#   1. DevModeAuthenticator — API accepts X-Dev-User-ID: <uuid> header so
#      Bruno / curl requests are authenticated without an OIDC session cookie.
#   2. OIDC secrets stored as v0-inline:<secret> (no Vault or encryption key needed).
#   3. CLUSTER_JOIN_SECRET is optional (fixed insecure fallback key used).
#   4. Agent auth accepts X-Agent-Cluster-ID header instead of mTLS certs.
#   5. cmd/seed allows v0-inline: OIDC secrets in seed files.
# Note: the webapp login form was OIDC-only — this flag only affects API-level auth.
APP_DEV_MODE=true

# AUTH_DEV_USER_HEADER — name of the HTTP request header that DevModeAuthenticator
#   reads to identify the caller. The header value must be a valid user UUID.
#   Default: X-Dev-User-ID (matches the Bruno collection and webapp dev proxy).
#   Only honoured when APP_DEV_MODE=true; ignored in production.
# AUTH_DEV_USER_HEADER=X-Dev-User-ID

# ── OIDC / session ─────────────────────────────────────────────────────────────
# Required in production (APP_DEV_MODE=false). Leave empty in pure dev mode.
#
# AUTH_SESSION_SECRET   — HS256 key for session + state JWTs (≥ 32 bytes, base64).
#                         Generate: openssl rand -base64 32
# AUTH_BASE_URL         — public base URL of this API, no trailing slash.
#                         Example: https://appstore.gov.nl or http://localhost:8080
# AUTH_COOKIE_DOMAIN    — restrict session cookie to this domain (leave empty
#                         in localhost dev to default to request host).
# AUTH_SESSION_TTL      — session JWT lifetime (default 8h).
# AUTH_CORS_ALLOWED_ORIGINS — comma-separated frontend origins that may send
#                         credentials. Required in production. Example:
#                         https://appstore.gov.nl,https://www.appstore.gov.nl
# AUTH_SECRET_ENCRYPTION_KEY — AES-256-GCM key for encrypting OIDC client
#                         secrets stored in the DB (32 bytes, base64).
#                         Generate: openssl rand -base64 32
#                         Required when APP_DEV_MODE=false and Vault is absent.
AUTH_SESSION_SECRET=
AUTH_BASE_URL=http://localhost:8080
AUTH_COOKIE_DOMAIN=
AUTH_SESSION_TTL=8h
AUTH_CORS_ALLOWED_ORIGINS=http://localhost:3000
AUTH_SECRET_ENCRYPTION_KEY=

# ── GitHub App ─────────────────────────────────────────────────────────────────
# All three vars must be set for the integration to be wired. Leave them
# empty in dev to make POST /apps return 503 github_not_configured (the
# rest of the API still works).
#
# GITHUB_APP_ID is the integer id shown on the App's settings page.
# GITHUB_APP_PRIVATE_KEY accepts the PEM inline (use \n for newlines) or
# use GITHUB_APP_PRIVATE_KEY_FILE to point at a file path.
# GITHUB_WEBHOOK_SECRET is the HMAC secret configured on the webhook settings.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_WEBHOOK_SECRET=

# ── Community discussions ──────────────────────────────────────────────────────
# Public GitHub Discussions proxy — GET /api/v1/community/discussions.
# Leave GITHUB_DISCUSSIONS_TOKEN empty to return an empty list gracefully.
#
# GITHUB_DISCUSSIONS_TOKEN — GitHub PAT with public_repo scope (or a
#   fine-grained token with "Discussions: Read" on the target repo).
#   Generate at: https://github.com/settings/tokens
# GITHUB_COMMUNITY_REPO  — "owner/repo" of the public platform repository.
GITHUB_DISCUSSIONS_TOKEN=
GITHUB_COMMUNITY_REPO=ClappFormOrg/SaidKick

# ── SARIF security gate ────────────────────────────────────────────────────────
# Which rule the Stage-1 security-scan gate blocks on. Any other value fails boot.
#
#   report  (default) Block only results with level "error" and a result-level
#           security-severity >= 7.0. Findings the stricter rule would add are
#           logged, counted in sarif_gate_would_block_total and written to the
#           audit log as sarif_gate.would_block, but do not block.
#   enforce Block every result whose security-severity >= 7.0, whatever its
#           level, reading severity from the result or from its rule in
#           runs[].tool.driver.rules[].
#
# Size the impact of switching with: go run ./cmd/sarif-gate-report -days 30
SARIF_GATE_MODE=report

# ── Orchestrator (Argo CD) ─────────────────────────────────────────────────────
# Connection details for the deployment orchestrator. Leave empty to wire
# the NullDeployer fallback (POST /deployments returns 503).
#
# ORCHESTRATOR_KIND: "argocd" or "agent" (agent-brokered via heartbeat queue).
# ARGOCD_SERVER_URL: base URL of Argo CD API, no trailing slash.
#   Example for in-cluster:   http://argocd-server.argocd.svc:443
#   Example for port-forward: http://localhost:8081
# ARGOCD_AUTH_TOKEN: bearer token from `argocd account generate-token`.
# ARGOCD_NAMESPACE: where Application CRs live (default: argocd).
# ARGOCD_INSECURE_SKIP_VERIFY: accept self-signed certs in dev.
#                              Refused at startup when APP_ENV=production.
ORCHESTRATOR_KIND=
ARGOCD_SERVER_URL=
ARGOCD_AUTH_TOKEN=
ARGOCD_NAMESPACE=argocd
ARGOCD_INSECURE_SKIP_VERIFY=false

# ── Vault / OpenBao ────────────────────────────────────────────────────────────
# Secret store for deployment secrets and OIDC client secrets.
# Leave empty in dev — the API falls back to InMemoryStore.
# In production, VAULT_ADDR + VAULT_TOKEN are required.
#
# VAULT_ADDR      — base URL of the Vault/OpenBao instance, no trailing slash.
#                   Example: http://localhost:8200 or https://vault.example.com
# VAULT_TOKEN     — static root/app token. In production, prefer AppRole.
# VAULT_MOUNT     — KV v2 mount path (default: kv).
# VAULT_APPROLE_MOUNT — AppRole auth mount name for per-cluster scoped tokens.
#                   Leave empty to use the static VAULT_TOKEN for all clusters.
# VAULT_PKI_MOUNT — PKI secrets engine mount for agent mTLS cert signing (default: pki).
# VAULT_PKI_ROLE  — PKI role that issues agent certificates (default: agent).
VAULT_ADDR=
VAULT_TOKEN=
VAULT_MOUNT=kv
VAULT_APPROLE_MOUNT=
VAULT_PKI_MOUNT=pki
VAULT_PKI_ROLE=agent

# ── Cluster registration ───────────────────────────────────────────────────────
# CLUSTER_JOIN_SECRET — HMAC-SHA256 key for one-time cluster join-token JWTs.
#   Required in production. In dev, a fixed insecure key is used when unset.
#   Generate: openssl rand -base64 32
# CLUSTER_HUB_ENDPOINT — public base URL returned to the agent in the handshake
#   response so it knows where to connect. Defaults to AUTH_BASE_URL when unset.
CLUSTER_JOIN_SECRET=
CLUSTER_HUB_ENDPOINT=
# CLUSTER_HUB_AGENT_ENDPOINT — public base URL of the agent mTLS listener as
#   agents reach it (e.g. https://agents.appstore.gov.nl:8443). Printed as
#   agent.hubAgentUrl in the agent install command when set.
# CLUSTER_HUB_AGENT_ENDPOINT=
# AGENT_CHART_REPO — OCI repository of the agent chart in the install command
#   (default oci://ghcr.io/clappformorg/charts).
# AGENT_CHART_VERSION — agent chart version printed as --version; empty leaves
#   the flag out. The hub chart sets it to its appVersion.
# AGENT_CHART_REPO=
# AGENT_CHART_VERSION=

# ── Agent mTLS listener ────────────────────────────────────────────────────────
# A second listener serves the agent routes (heartbeat, deployment-states,
# command ack) with TLS 1.3 and a required client certificate. The main
# listener never serves them outside dev mode.
# AGENT_TLS_ADDR        — listen address (default :8443).
# AGENT_TLS_CERT_FILE   — PEM serving certificate presented to agents.
# AGENT_TLS_KEY_FILE    — PEM key for that certificate.
# AGENT_CLIENT_CA_FILE  — PEM CA bundle that signs agent certificates: the CA
#                         of the Vault PKI mount (VAULT_PKI_MOUNT) used by the
#                         handshake.
# Set all three files or none. They are required unless APP_ENV is
# dev/development/local/test/ci; in dev without them the agent routes are
# served on HTTP_ADDR with the X-Agent-Cluster-ID header (APP_DEV_MODE=true).
# AGENT_TLS_ADDR=:8443
# AGENT_TLS_CERT_FILE=
# AGENT_TLS_KEY_FILE=
# AGENT_CLIENT_CA_FILE=

# ── Database seeding ───────────────────────────────────────────────────────────
# Used by: go run ./cmd/seed <file>
# SEED_FILE — path to the seed JSON file. Can also be passed as the first
#   CLI argument instead.
# Per-org OIDC client secrets are read from the env var named in each org's
# "oidc_client_secret_env" field of the seed file.
#
# Example: if seed.json contains "oidc_client_secret_env": "PLATFORM_OIDC_SECRET"
# SEED_FILE=seed.json
# PLATFORM_OIDC_SECRET=

# ── encryptref tool ────────────────────────────────────────────────────────────
# Used by: go run ./cmd/encryptref
# Reads OIDC_CLIENT_SECRET from this file, encrypts it with
# AUTH_SECRET_ENCRYPTION_KEY, and prints the encrypted: ref + SQL statement.
# OIDC_CLIENT_SECRET=
