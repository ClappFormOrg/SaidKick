## ---------------------------------------------------------------------
## sAId-Kick Appstore — dev-image postgresql.conf overrides
##
## These lines are appended to the sample postgresql.conf shipped with
## the official postgres:16-alpine image. They tune logging + a few
## sensible defaults for laptop work; production tuning is owned by the
## Helm chart that runs the hub Postgres.
## ---------------------------------------------------------------------

# Log every statement that takes longer than 200ms.
log_min_duration_statement = 200ms

# Show parameters of slow queries so we can reproduce them.
log_parameter_max_length     = 1024
log_parameter_max_length_on_error = 1024

# Track planning + execution times in the auto-explain output (off by
# default — operators can SET auto_explain.log_min_duration = 200 once
# the extension is loaded).
auto_explain.log_min_duration = -1

# Allow up to 200 connections — fine for a single API process + a
# psql shell + a Goose migration window.
max_connections = 200

# Per-connection work_mem; keep small so 200 concurrent sorts don't OOM
# a laptop.
work_mem = 16MB

# Default 4MB; bumping helps catalogue full-text searches.
shared_buffers = 256MB

# Use UTC timestamps everywhere — matches GORM's NowFunc.
timezone = 'UTC'
